{
  "name": "soluterminal-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/emit-webdist-provenance.mjs",
    "build:preview": "vite build --base=./",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "screens": "node tools/capture-screens.mjs --dist dist --out ../docs/screenshots",
    "capture:context-pack": "node tools/capture-context-pack.mjs --dist dist --out ../docs/screenshots",
    "capture:update-deferred": "node tools/capture-update-deferred.mjs --dist dist --out ../docs/evidence/update-deferred",
    "capture:update-rollback": "node tools/capture-update-rollback.mjs --dist dist --out ../docs/evidence/update-rollback",
    "capture:support-bundle": "node tools/capture-support-bundle.mjs --dist dist --out ../docs/screenshots",
    "capture:credentials-keys": "node tools/capture-credentials-keys.mjs --dist dist --out ../docs/screenshots"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "playwright": "1.59.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
