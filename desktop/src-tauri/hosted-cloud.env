# Hosted cloud for the SoluTerminal product build, read by build.rs.
# An environment variable of the same name overrides each value; an empty
# SOLU_CLOUD_URL builds a shell with no cloud.
SOLU_CLOUD_URL=https://soluterminal-cloud.onrender.com
# Browser-facing domain of the same cloud, opened by the pairing dialog.
SOLU_CLOUD_APP_URL=https://app.soluterminal.com
