# Copy this to ~/.solu/service.env and fill in your values to enable
# the cloud relay in the systemd --user service. The file is optional;
# without it, the daemon runs local-only on 127.0.0.1:8787.
#
#   cp systemd/service.env.example ~/.solu/service.env
#   chmod 600 ~/.solu/service.env
#   systemctl --user restart soluterminal
#
# Keep this file readable only by you — it contains a relay token.
#
# --backend-id identifies this daemon's cloud tunnel. Use "wsl" for a WSL
# daemon, or "host" for a native Linux/macOS host. Desktop-managed Windows
# daemons use their own "win" backend, so keeping this explicit prevents the
# cloud from seeing this host as a legacy unnamed backend.

RELAY_ARGS=--relay wss://YOUR_RELAY_HOST/relay --relay-token YOUR_MACHINE_TOKEN_HERE --backend-id YOUR_BACKEND_ID
