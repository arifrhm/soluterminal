[Unit]
Description=soluterminal daemon — multi-pane terminal host for Claude Code sessions
After=network.target
# Crash-loop guard. Without an explicit window, a daemon that fails fast
# at startup (corrupt ~/.solu state, a port already held, a bad
# auto-updated binary) either trips the user-manager default
# (5 restarts / 10s → unit goes permanently `failed`, product silently
# dead with no recovery) or, if each crash takes >2s, loops forever and
# floods the journal (the historical 309,784-restart / 2-week incident).
# Allow up to 10 restarts within 5 minutes before giving up; combined
# with RestartSec=5 below this tolerates transient swap/port races while
# still bounding a genuinely broken binary.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# Adjust EXEC_PATH to the location of your solud binary if you move it.
# $HOME is expanded by systemd --user.
#
# Optional cloud relay: create %h/.solu/service.env with
#     RELAY_ARGS=--relay wss://your-cloud-url/relay --relay-token YOUR_TOKEN --backend-id wsl
# Use --backend-id host for native Linux/macOS systemd-style installs.
# and the daemon will also dial out to the cloud. Absent file = local only.
EnvironmentFile=-%h/.solu/service.env
ExecStart=%h/wsl-projects/soluterminal/daemon/solud --addr 127.0.0.1:8787 $RELAY_ARGS
Restart=always
# 5s (was 2s) so a fast-failing startup doesn't burn the StartLimitBurst
# in a couple of seconds, and the journal isn't spammed at 2s cadence.
RestartSec=5
# Keep logs in the journal; view with: journalctl --user -u soluterminal -f
StandardOutput=journal
StandardError=journal
# Don't kill spawned agent processes when the daemon unit stops — they're
# Setsid'd and survive daemon restarts intentionally, so a new daemon can
# reattach to them. KillMode=process prevents the main daemon's PID being
# used to signal the whole session group.
KillMode=process
# Allow the daemon to create per-command cgroup v2 scopes. Processes still
# survive daemon replacement; explicit scope cancellation owns their teardown.
Delegate=yes
TimeoutStopSec=5

[Install]
WantedBy=default.target
